# NextAuth
NEXTAUTH_SECRET=please-change-me-to-a-random-string
NEXTAUTH_URL=http://localhost:3000

# Bootstrap 管理员（由 scripts/seed.mjs 创建首个用户）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# GitHub OAuth（可选，用于 Git 仓库授权与登录）
GITHUB_ID=
GITHUB_SECRET=

# Neon Postgres
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# AES 加密主密钥（64 字节 hex = 32 字节密钥）
# 生成方式: openssl rand -hex 32
ENCRYPTION_KEY=

# ECS RAM Role 名（部署期常量，需在阿里云创建并授权 OSS + ACR）
# 默认 workspace-cloud-ecs-role

# 云函数轮询器鉴权（docs/CLOUD-FUNCTION-WORKERS.md §5.2）
# 后端 /api/internal/instances/[id]/poll 用同一 token 做 Bearer 校验；
# 云函数环境变量需配 RUNNER_URL（本站根地址）+ TASKS_WORKER_TOKEN（同一 token）。
TASKS_WORKER_TOKEN=please-change-me-to-a-random-string
